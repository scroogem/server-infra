# =====================================================================
#  server-infra — secrets.env TEMPLATE
#  Скопируйте этот файл в `secrets.env`, заполните ВСЕ значения реальными
#  ключами и закиньте его на новый сервер. bootstrap.sh прочитает его,
#  разложит значения по нужным .env-файлам проектов и УДАЛИТ его в конце
#  (или оставит, см. KEEP_SECRETS=1).
#
#  Ни в коем случае НЕ коммитьте заполненный secrets.env!
#  Этот шаблон — единственное, что попадает в Git.
# =====================================================================

# ---------------------------------------------------------------------
# GitHub (нужен для клонирования приватных репозиториев)
# ---------------------------------------------------------------------
GITHUB_USER=scroogem
# Fine-grained PAT с read-доступом к приватным репо из repos.txt
GITHUB_TOKEN=

# ---------------------------------------------------------------------
# Tailscale
# ---------------------------------------------------------------------
# Если пусто — после установки будет выведена команда ручного входа:
#   sudo tailscale up
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=giadaserver

# ---------------------------------------------------------------------
# Vairy Docker-стек — файл ~/stack/vairy/.env
# ---------------------------------------------------------------------
VAIRY_SECRET_KEY=
VAIRY_JWT_SECRET_KEY=
VAIRY_ENCRYPTION_KEY=
VAIRY_PASSWORD_PEPPER=
VAIRY_FLASK_ENV=production
VAIRY_DATABASE_URL=
VAIRY_SUPABASE_URL=
VAIRY_SUPABASE_KEY=
VAIRY_SUPABASE_ANON_KEY=
VAIRY_SUPABASE_JWT_SECRET=
VAIRY_UPSTASH_REDIS_REST_URL=
VAIRY_UPSTASH_REDIS_REST_TOKEN=
VAIRY_REDIS_URL=
VAIRY_GOOGLE_CLIENT_ID=
VAIRY_GEMINI_API_KEY=

# ---------------------------------------------------------------------
# Talky Docker-стек — файл ~/stack/talky/.env
# ---------------------------------------------------------------------
TALKY_SOCIAL_TRAINER_SECRET_KEY=
TALKY_SOCIAL_TRAINER_JWT_SECRET=
TALKY_SOCIAL_TRAINER_PASSWORD_PEPPER=
TALKY_FLASK_ENV=production
TALKY_SOCIAL_TRAINER_DB_URL=
TALKY_SOCIAL_TRAINER_SUPABASE_URL=
TALKY_SOCIAL_TRAINER_SUPABASE_ANON_KEY=
TALKY_SOCIAL_TRAINER_REDIS_URL=
TALKY_SOCIAL_TRAINER_GOOGLE_CLIENT_ID=
TALKY_SOCIAL_TRAINER_GEMINI_KEY=

# ---------------------------------------------------------------------
# Cloudflare Tunnel (vairy-api) — ~/stack/cloudflared/
# ---------------------------------------------------------------------
CLOUDFLARED_TUNNEL_ID=
# Содержимое credentials-файла 6b77100a-...json
CLOUDFLARED_CREDENTIALS_JSON=

# ---------------------------------------------------------------------
# claude-web — ~/projects/claude-web/.env
# ---------------------------------------------------------------------
CLAUDE_WEB_AUTH_TOKEN=
CLAUDE_WEB_PORT=8787

# Claude CLI-креды (необязательно). base64 от ~/.claude/.credentials.json:
#   base64 -w0 ~/.claude/.credentials.json
# Если пусто — будет выведена команда ручного входа:  claude
CLAUDE_CREDENTIALS_B64=

# ---------------------------------------------------------------------
# gramgift — ~/projects/gramgift/.env
# ---------------------------------------------------------------------
GRAMGIFT_DATABASE_URL=
GRAMGIFT_APP_BASE_URL=
GRAMGIFT_ADMIN_IDS=
GRAMGIFT_JWT_SECRET=
GRAMGIFT_ALLOWED_BOT_USERS=
GRAMGIFT_BOT_TOKEN=
GRAMGIFT_VITE_API_URL=
GRAMGIFT_BOT_USERNAME=
GRAMGIFT_ADMIN_PASSWORD=
GRAMGIFT_POSTGRES_USER=
GRAMGIFT_POSTGRES_PASSWORD=
GRAMGIFT_POSTGRES_DB=
GRAMGIFT_ALLOW_DEV_AUTH=

# ---------------------------------------------------------------------
# OmniRoute (опционально, НЕ запускается автоматически) — ~/.omniroute/server.env
# ---------------------------------------------------------------------
OMNIROUTE_JWT_SECRET=
OMNIROUTE_STORAGE_ENCRYPTION_KEY=
OMNIROUTE_API_KEY_SECRET=

# ---------------------------------------------------------------------
# mem0 — долговременная память opencode-агента: ~/.mem0/config.json
# Память хранится в облаке mem0.ai, поэтому ключ тянет её на новую машину.
#   API-ключ и user_id:  mem0 via "Что скопировать при переезде" в README
#   (или у вас: ~/.mem0/config.json → поле platform.api_key / defaults.user_id).
# Если пусто — после bootstrap выполните вручную:  mem0 init --email your@email
# ---------------------------------------------------------------------
MEM0_API_KEY=
MEM0_USER_ID=